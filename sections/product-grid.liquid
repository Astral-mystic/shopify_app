{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-product-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-base.js' | asset_url }}" defer></script>

{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}

<section
  class="pl-scope pl-section"
  id="shop-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="product-grid"
  style="{% render 'purelane-scene', depth: section.settings.scene_depth %}"
>
  <div class="pl-wrap">
    <div class="pl-grid-head">
      <div class="pl-panel-head pl-rv">
        {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        <div class="pl-rule"><i></i>{% render 'purelane-icon', name: 'leaf' %}<i></i></div>
      </div>
      {%- if section.settings.show_view_all and collection != blank -%}
        <a class="pl-btn pl-btn-ghost pl-grid-cta" href="{{ collection.url }}">
          {{ section.settings.view_all_label | default: 'View all' }}
          {% render 'purelane-icon', name: 'arrow' %}
        </a>
      {%- endif -%}
    </div>

    {%- if collection != blank and collection.products.size > 0 -%}
      <div class="pl-shelf">
        {%- for product in collection.products limit: limit -%}
          {%- assign delay = forloop.index0 | modulo: 4 -%}
          {% render 'product-card', product: product, reveal_delay: delay %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="pl-shelf">
        {%- for i in (1..limit) -%}
          <div class="pl-glass pl-card">
            <div class="pl-card-shot"><div class="pl-card-img pl-card-img--placeholder"></div></div>
            <h4>Example product</h4>
            <div class="pl-card-pr"><strong>{{ 20000 | money_without_trailing_zeros }}</strong></div>
          </div>
        {%- endfor -%}
      </div>
      <p class="pl-lede" style="margin-top:16px">Select a collection in the section settings to show real products here.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop / Product grid",
  "tag": "section",
  "class": "shopify-section--product-grid",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Eyebrow text", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products, prices, images and reviews are pulled live from this collection."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show \"View all\" button", "default": true },
    { "type": "text", "id": "view_all_label", "label": "\"View all\" label", "default": "View all" },
    {
      "type": "select",
      "id": "scene_depth",
      "label": "Background mood",
      "info": "Matches the section to where it typically sits on the scroll journey.",
      "options": [
        { "value": "1", "label": "Bright — near the top" },
        { "value": "2", "label": "Mid-light" },
        { "value": "3", "label": "Mid-deep (default)" },
        { "value": "4", "label": "Deep — near the footer" }
      ],
      "default": "3"
    }
  ],
  "presets": [
    { "name": "Shop / Product grid" }
  ]
}
{% endschema %}
